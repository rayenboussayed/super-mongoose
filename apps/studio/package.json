{
  "name": "@super-mongoose/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TanStack Start studio for super-mongoose",
  "scripts": {
    "dev": "vite dev --port 3010",
    "build": "vite build",
    "start": "vite preview --port 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.4",
    "@astryxdesign/theme-neutral": "^0.7.4",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "bson": "^7.3.3",
    "mongoose": "^9.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "super-mongoose": "*"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
